{
  "name": "logodock",
  "version": "0.1.0",
  "private": true,
  "description": "收录公司 Logo，提供预览、下载与来源信息，由社区共同维护。",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.0.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "prepare:asset": "node scripts/prepare-asset.mjs",
    "validate": "node scripts/validate.mjs",
    "build:index": "node scripts/build-index.mjs",
    "check:index": "node scripts/build-index.mjs --check",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm run validate && npm run check:index && npm run check:types && npm test",
    "build": "node scripts/build-site.mjs",
    "check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "playwright test",
    "pretest": "npm run build:site"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/didilili/logodock.git"
  },
  "dependencies": {
    "bits-ui": "2.20.6",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
